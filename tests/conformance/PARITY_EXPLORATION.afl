// PARITY CHECK - run as EXPLORATION in AmiBroker AND in the app. Same AFL, same symbols, same range.
// Apply to: a filter/watchlist of ~5 symbols (e.g. RELIANCE, TCS, INFY, ITC, HDFCBANK). Range: All quotes.
// Run twice: once with periodicity Daily, once Weekly. Export CSV each time and send all 4 files.
Filter = 1;
C1 = Close; H1 = High; L1 = Low; V1 = Volume;
AddColumn( Open,  "Open", 1.4 );   AddColumn( H1, "High", 1.4 );
AddColumn( L1, "Low", 1.4 );       AddColumn( C1, "Close", 1.4 );  AddColumn( V1, "Volume", 1.0 );
AddColumn( MA(C1,10),  "MA10", 1.4 );    AddColumn( MA(C1,50),  "MA50", 1.4 );
AddColumn( EMA(C1,10), "EMA10", 1.4 );   AddColumn( EMA(C1,26), "EMA26", 1.4 );
AddColumn( WMA(C1,10), "WMA10", 1.4 );   AddColumn( DEMA(C1,10), "DEMA10", 1.4 );
AddColumn( TEMA(C1,10), "TEMA10", 1.4 ); AddColumn( Wilders(C1,14), "WILD14", 1.4 );
AddColumn( RSI(14), "RSI14", 1.4 );      AddColumn( RSI(5), "RSI5", 1.4 );
AddColumn( ATR(14), "ATR14", 1.4 );      AddColumn( ADX(14), "ADX14", 1.4 );
AddColumn( PDI(14), "PDI14", 1.4 );      AddColumn( MDI(14), "MDI14", 1.4 );
AddColumn( CCI(20), "CCI20", 1.4 );      AddColumn( MFI(14), "MFI14", 1.4 );
AddColumn( StochK(14,3), "STK", 1.4 );   AddColumn( StochD(14,3,3), "STD", 1.4 );
AddColumn( MACD(12,26), "MACD", 1.4 );   AddColumn( Signal(12,26,9), "SIGNAL", 1.4 );
AddColumn( ROC(C1,10), "ROC10", 1.4 );   AddColumn( OBV(), "OBV", 1.0 );
AddColumn( HHV(H1,20), "HHV20", 1.4 );   AddColumn( LLV(L1,20), "LLV20", 1.4 );
AddColumn( HHVBars(H1,20), "HHVB20", 1.0 ); AddColumn( LLVBars(L1,20), "LLVB20", 1.0 );
AddColumn( Ref(C1,-1), "REF1", 1.4 );    AddColumn( Ref(C1,-5), "REF5", 1.4 );
AddColumn( Sum(C1,10), "SUM10", 1.4 );   AddColumn( Cum(1), "BARS", 1.0 );
AddColumn( StDev(C1,20), "STDEV20", 1.4 );
AddColumn( BBandTop(C1,20,2), "BBTOP", 1.4 ); AddColumn( BBandBot(C1,20,2), "BBBOT", 1.4 );
AddColumn( LinRegSlope(C1,20), "LRS20", 1.4 ); AddColumn( LinearReg(C1,20), "LR20", 1.4 );
AddColumn( TSF(C1,20), "TSF20", 1.4 );   AddColumn( Correlation(C1,V1,20), "CORR20", 1.4 );
TR1 = Max( H1 - L1, Max( abs( H1 - Ref(C1,-1) ), abs( L1 - Ref(C1,-1) ) ) );
AddColumn( TR1, "TR", 1.4 );
AddColumn( SAR(0.02,0.2), "SAR", 1.4 );
cx = Cross( EMA(C1,10), EMA(C1,26) );
AddColumn( cx, "CROSS", 1.0 );
AddColumn( BarsSince(cx), "BARSSINCE", 1.0 );
AddColumn( ValueWhen(cx, C1), "VALUEWHEN", 1.4 );
AddColumn( ExRem(cx, Cross(EMA(C1,26),EMA(C1,10))), "EXREM", 1.0 );
AddColumn( Flip(cx, Cross(EMA(C1,26),EMA(C1,10))), "FLIP", 1.0 );
AddColumn( Highest(C1), "HIGHEST", 1.4 ); AddColumn( Lowest(C1), "LOWEST", 1.4 );
AddColumn( Peak(C1,10), "PEAK10", 1.4 ); AddColumn( Trough(C1,10), "TROUGH10", 1.4 );
AddColumn( Zig(C1,10), "ZIG10", 1.4 );
AddColumn( IIf(C1>MA(C1,20),1,-1), "IIF", 1.0 );
AddColumn( Round(C1*7.3), "ROUND", 1.0 ); AddColumn( Min(C1,H1*0.99), "MIN", 1.4 );
AddColumn( DayOfWeek(), "DOW", 1.0 );     AddColumn( Month(), "MON", 1.0 );
